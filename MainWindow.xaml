<Window x:Class="Cookie_clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cookie_clicker"
        mc:Ignorable="d"
        Title="Cookie Clicker" Height="450" Width="800"
        Background="#FF121212">

    <Grid>
        
        <TextBlock x:Name="pocetCookies" Text="0" HorizontalAlignment="Left" Margin="235,194,0,0" VerticalAlignment="Top" FontSize="48" FontWeight="Bold" Foreground="#FFFFD700"/>

        
        <TextBlock x:Name="txtblockCPS" Text="Za sekundu: 0" HorizontalAlignment="Left" Margin="235,164,0,0" VerticalAlignment="Top" FontSize="16" Foreground="#FFB0B0B0" Background="Transparent"/>

        
        <Button x:Name="Cookie_btn" Content="Cookie" HorizontalAlignment="Left" Height="140" Margin="60,150,0,0" VerticalAlignment="Top" Width="140" FontSize="22" FontWeight="Bold" Click="Cookie_btn_Click" Background="#FFD4AF37" Foreground="Black" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15"/>
                </Style>
            </Button.Resources>
        </Button>

        
        <Button x:Name="Curzorbtn" Content="Kurzor 10" HorizontalAlignment="Left" Height="50" Margin="520,70,0,0" VerticalAlignment="Top" Width="160" Click="Button_Click" Background="#FF2D2D2D" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>

        <Button x:Name="btnBabka" Content="Babka 100" HorizontalAlignment="Left" Height="50" Margin="520,135,0,0" VerticalAlignment="Top" Width="160" Click="btnBabka_Click" Background="#FF2D2D2D" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>

        <Button x:Name="btnBana" Content="Baňa 1000" HorizontalAlignment="Left" Height="50" Margin="520,200,0,0" VerticalAlignment="Top" Width="160" Click="btnBana_Click" Background="#FF2D2D2D" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>

    </Grid>
</Window>